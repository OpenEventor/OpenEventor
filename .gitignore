# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
# NOTE: anchored to repo root so it never matches cmd/server/ (which was
# previously swallowed by a bare "server" rule, losing the server entrypoint).
/server

# Go build/test
*.test
*.out
*.prof

# Dependency directory
vendor/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Data (SQLite databases, runtime data)
data/
*.db
*.db-wal
*.db-shm

# Environment / secrets
.env
.env.*

# Frontend build output
frontend/node_modules/
frontend/dist/*
!frontend/dist/.gitkeep
frontend/build/

# Build output
dist/

# Temporary files
tmp/
*.tmp
*.log
