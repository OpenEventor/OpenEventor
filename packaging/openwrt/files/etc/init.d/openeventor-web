#!/bin/sh /etc/rc.common
# OpenEventor web — procd service. Auto-starts on boot, respawns on crash.
# Runs alongside the OpenEventor Hub (oe-hub, :8080) on the same router; in the
# web UI add the "OpenEventor HUB" timing system with address 127.0.0.1:8080.

USE_PROCD=1
START=96
STOP=10
PROG=/usr/bin/openeventor-web

start_service() {
	config_load openeventor-web
	local port data
	config_get port   main port 8081
	config_get data   main data /usr/share/openeventor-web

	mkdir -p "$data"

	procd_open_instance
	procd_set_param command "$PROG" -no-browser -port "$port"
	procd_set_param env DATA_DIR="$data"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "openeventor-web"
}
